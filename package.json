{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "spyder",
    "description": "A powerful schema-based web scraping library for Node.js built for fast, structured, and reliable data extraction.",
    "private": false,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "README.md",
        "LICENSE",
        "dist"
    ],
    "keywords": [
        "web-scraping",
        "http-client",
        "scraper",
        "crawler",
        "parsing",
        "cheerio",
        "html",
        "xml"
    ],
    "license": "MIT",
    "author": {
        "name": "Lucas",
        "email": "jlucasmelob558@gmail.com",
        "url": "https://github.com/lucaaszsx"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lucaaszsx/spyder.git"
    },
    "bugs": {
        "url": "https://github.com/lucaaszsx/spyder/issues"
    },
    "homepage": "https://github.com/lucaaszsx/spyder#README",
    "scripts": {
        "clean": "rimraf dist",
        "prebuild": "pnpm run type-check",
        "build": "tsup",
        "build:only": "tsup --no-clean",
        "dev:playground": "tsx scripts/playground.ts",
        "type-check": "tsgo --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "check": "pnpm run type-check && pnpm run lint && pnpm run format:check",
        "fix": "pnpm lint:fix && pnpm format:write",
        "prepare": "husky"
    },
    "packageManager": "pnpm@11.2.2",
    "dependencies": {
        "cheerio": "^1.2.0",
        "undici": "^7.19.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@eslint/js": "^9.39.2",
        "@inquirer/prompts": "^8.4.3",
        "@types/node": "^25.0.10",
        "@typescript/native-preview": "7.0.0-dev.20260605.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "rimraf": "^6.0.1",
        "tsup": "^8.5.1",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.4"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{md,json}": [
            "prettier --write"
        ]
    }
}
