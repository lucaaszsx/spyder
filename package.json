{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "webcrap",
    "description": "A schema-based web scraping toolkit for fast and structured data extraction.",
    "private": false,
    "main": "./dist/index.js",
    "types": "./dist/",
    "exports": {
        ".": {
            "import": {
                "types": "./typings/index.d.mts",
                "default": "./src/index.js"
            },
            "require": {
                "types": "./typings/index.d.ts",
                "default": "./src/index.js"
            }
        }
    },
    "files": ["dist"],
    "keywords": [
        "web-scraping",
        "http-client",
        "scraper",
        "crawler",
        "parsing",
        "cheerio",
        "html",
        "xml"
    ],
    "license": "MIT",
    "contributors": [
        {
            "email": "jlucasmelob558@gmail.com",
            "name": "Lucas",
            "url": "https://github.com/lucaaszsx"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/lucaaszsx/webcrap.git"
    },
    "bugs": {
        "url": "https://github.com/lucaaszsx/webcrap/issues"
    },
    "homepage": "https://github.com/lucaaszsx/webcrap#README",
    "scripts": {
        "clean": "rimraf dist",
        "prebuild": "pnpm run check",
        "build": "tsup",
        "build:only": "tsup --no-clean",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "check": "pnpm run type-check && pnpm run lint && pnpm run format:check",
        "fix": "pnpm lint:fix && pnpm format:write"
    },
    "packageManager": "pnpm@11.2.2",
    "dependencies": {
        "undici": "^7.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^25.0.10",
        "@typescript-eslint/eslint-plugin": "^8.53.1",
        "@typescript-eslint/parser": "^8.53.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-only-warn": "^1.1.0",
        "globals": "^17.1.0",
        "prettier": "^3.8.3",
        "rimraf": "^6.0.1",
        "tsup": "^8.5.1",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3"
    }
}
